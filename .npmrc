# obsidian's package.json declares older @codemirror/* peer versions than
# this repo actually uses. @codemirror/* is marked "external" in
# esbuild.config.mjs -- Obsidian supplies it at runtime, so these packages
# are only ever used here for TypeScript types, never bundled or executed
# from node_modules. Safe to relax the peer check rather than downgrade.
legacy-peer-deps=true
